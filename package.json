{
  "name": "epoch-the-living-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "dev:host": "vite --host"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/three": "^0.170.0",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
